# Copy to .env and fill in. Never commit .env.
# Phase 1 runs entirely locally with no API keys.

# Commentary provider: deterministic | ollama | claude_api
# Only "deterministic" is implemented in Phase 1.
LLM_PROVIDER=deterministic

# Where client config and data live (defaults are fine for local runs)
FINANCE_CONFIG_DIR=config/clients
FINANCE_DATA_DIR=data/clients
FINANCE_OUTPUT_DIR=output/clients

# Reserved for later phases. Leave blank locally.
OLLAMA_BASE_URL=
ANTHROPIC_API_KEY=

# QuickBooks sandbox (Phase 2 — not used by finance_engine)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox
