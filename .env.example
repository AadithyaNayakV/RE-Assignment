# Copy to .env and fill in. Never commit .env. Placeholders only: no real value goes here.
# finance_engine reads only the variables in the first block. It needs no API key.

# ---- finance_engine (read by finance_engine/config.py) ----
# Commentary provider: deterministic (default) | auto | gemini | claude-api
# auto, gemini and claude-api use config/providers.yaml and always fall back to the
# deterministic report. The Claude skill is separate: it needs no setting.
LLM_PROVIDER=deterministic
FINANCE_CONFIG_DIR=config/clients
FINANCE_DATA_DIR=data/clients
FINANCE_OUTPUT_DIR=output/clients

# ---- Cloud commentary providers (optional; see README) ----
# Read only by --provider auto | gemini | claude-api, and only these two names.
# GEMINI_API_KEY: from Google AI Studio. ANTHROPIC_API_KEY: from the Anthropic Console,
# billed separately from Claude Pro; also needs claude-api.enabled: true in
# config/providers.yaml.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Reserved; nothing reads it. ----
OLLAMA_BASE_URL=

# ---- Eval and test tooling (optional) ----
# Path to the claude executable if it is not on PATH (evals/run_skill_evals.py).
# CLAUDE_BIN=
# Opt in to the QuickBooks MCP tests in tests/integration (default: skipped).
# QBO_INTEGRATION=1
# QBO_LIVE=1

# ---- QuickBooks sandbox: the direct read-only reader (pull-quickbooks) ----
# Read only by `pull-quickbooks`, `report --source quickbooks` and scripts/qb_smoke.py.
# From the reader's OWN Intuit development app, never the MCP server's (Intuit rotates
# refresh tokens; two programs cannot share one). QBO_REFRESH_TOKEN is the seed: the
# rotated token is kept in .secrets/quickbooks_reader_token.json (git-ignored).
# QBO_ENVIRONMENT must be sandbox; anything else is refused. See docs/quickbooks_setup.md.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
# Used only when you authorise the app, not by the reader.
QBO_REDIRECT_URI=

# ---- QuickBooks MCP server (Claude Code) ----
# NOT read by finance_engine. The MCP server reads quickbooks-online-mcp-server/.env, which
# `npm run auth` fills in. Its variables are listed in that folder's .env.example:
#   QUICKBOOKS_CLIENT_ID, QUICKBOOKS_CLIENT_SECRET, QUICKBOOKS_REDIRECT_URI,
#   QUICKBOOKS_ENVIRONMENT, and the refresh token and realm ID the auth step writes.
# Optional, set in the host process environment (not inside .env):
#   QUICKBOOKS_TOKEN_STORE_PATH  - one token file per client
