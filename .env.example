# Copy to .env and fill in. Never commit .env. Placeholders only: no real value goes here.
# finance_engine reads only the variables in the first block. It needs no API key.

# ---- finance_engine (read by finance_engine/config.py) ----
# Commentary provider: deterministic | ollama | claude_api
# Only "deterministic" is implemented. The Claude skill is separate: it needs no setting.
LLM_PROVIDER=deterministic
FINANCE_CONFIG_DIR=config/clients
FINANCE_DATA_DIR=data/clients
FINANCE_OUTPUT_DIR=output/clients

# ---- Reserved for later providers. Leave blank; nothing reads them yet. ----
OLLAMA_BASE_URL=
ANTHROPIC_API_KEY=

# ---- Eval and test tooling (optional) ----
# Path to the claude executable if it is not on PATH (evals/run_skill_evals.py).
# CLAUDE_BIN=
# Opt in to the QuickBooks MCP tests in tests/integration (default: skipped).
# QBO_INTEGRATION=1
# QBO_LIVE=1

# ---- QuickBooks sandbox ----
# NOT read by finance_engine. The MCP server reads quickbooks-online-mcp-server/.env, which
# `npm run auth` fills in. Its variables are listed in that folder's .env.example:
#   QUICKBOOKS_CLIENT_ID, QUICKBOOKS_CLIENT_SECRET, QUICKBOOKS_REDIRECT_URI,
#   QUICKBOOKS_ENVIRONMENT, and the refresh token and realm ID the auth step writes.
# Optional, set in the host process environment (not inside .env): 
#   QUICKBOOKS_TOKEN_STORE_PATH  - one token file per client
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENVIRONMENT=sandbox
